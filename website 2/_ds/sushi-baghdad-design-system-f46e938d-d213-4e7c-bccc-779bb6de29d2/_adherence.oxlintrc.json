{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/culture/**",
              "components/feedback/**",
              "components/food/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/**",
              "ui_kits/app/**",
              "ui_kits/pwa/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Dela Gothic One|IBM Plex Sans Arabic|Noto Sans JP|M PLUS Rounded 1c))/i]",
        "message": "Font not provided by the design system. Available: Dela Gothic One, IBM Plex Sans Arabic, Noto Sans JP, M PLUS Rounded 1c."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArtistCredit'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|location|avatar|source|reviewer|compact|onOpen|style|key|ref|className|style|children)$/]",
        "message": "<ArtistCredit> doesn't accept that prop. Declared props: name, role, location, avatar, source, reviewer, compact, onOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|eyebrow|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, eyebrow, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|green|neutral|solidRed|solidGreen|dark|glass|locked)$/]",
        "message": "<Badge> tone must be one of 'red' | 'green' | 'neutral' | 'solidRed' | 'solidGreen' | 'dark' | 'glass' | 'locked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|full|disabled|loading|done|doneLabel|icon|trailingIcon|as|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, full, disabled, loading, done, doneLabel, icon, trailingIcon, as, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|ghost|glass|onred)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'ghost' | 'glass' | 'onred'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
